{
  "name": "npm-workspaces-fixture",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "npm-workspaces-fixture",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "packages/api": {
      "name": "@fixture/api",
      "version": "1.0.0",
      "dependencies": {
        "express": "4.17.1"
      }
    },
    "packages/web": {
      "name": "@fixture/web",
      "version": "1.0.0",
      "dependencies": {
        "lodash": "4.17.15"
      }
    },
    "node_modules/@fixture/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@fixture/web": {
      "resolved": "packages/web",
      "link": true
    },
    "node_modules/cookie": {
      "version": "0.4.0"
    },
    "node_modules/express": {
      "version": "4.17.1",
      "dependencies": {
        "cookie": "0.4.0"
      }
    },
    "node_modules/lodash": {
      "version": "4.17.15"
    }
  }
}
